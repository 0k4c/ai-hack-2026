# 必要な環境変数の「名前」だけを書くファイルです。
# 本物のキーは各自のローカルの .env か、利用サービスのSecretsに置いてください。
# .env はGitに入りません。このファイル（.env.example）はGitに入ります。値を書かないでください。

# OrcaRouter（https://www.orcarouter.ai/）のAPIキー。OrcaRouter Consoleで取得します。
# 受け取り: https://www.orcarouter.ai/redeem/ コード AI-HACK-LOVES-ORCAROUTER
# キーは1人1つ。クレジットも1人3,000円分なので、3人がそれぞれ自分のキーを使います。
ORCAROUTER_API_KEY=

# 任意。未設定時は orcarouter/auto を使います。
# Named Router を作った場合は orcarouter/<名前> を指定します。
ORCAROUTER_MODEL=
